<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08060A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♛  BUZZER 2.0"
            android:textColor="#FF9CC0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Device Control Center"
            android:textColor="#FFF7FB"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This app receives authorized commands from your Buzzer control server."
            android:textColor="#B7A7B2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="#151017"
            android:text="● DEVICE ONLINE"
            android:textColor="#6DF2AD"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            android:background="#151017"
            android:text="🔋 Battery: checking..."
            android:textColor="#FFF7FB"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TRUST LEVELS"
            android:textColor="#B7A7B2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/publicLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="15dp"
            android:background="#151017"
            android:text="🔔 PUBLIC  ·  Summon + message"
            android:textColor="#FFF7FB"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/superiorLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="15dp"
            android:background="#151017"
            android:text="👑 SUPERIOR  ·  Advanced controls"
            android:textColor="#FFF7FB"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/godLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="15dp"
            android:background="#151017"
            android:text="☠ GOD  ·  Device-management controls"
            android:textColor="#FFF7FB"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="FCM DEVICE TOKEN"
            android:textColor="#B7A7B2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tokenView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:background="#0D0A0F"
            android:text="Getting FCM token..."
            android:textColor="#DCCBD4"
            android:textSize="11sp" />

        <Button
            android:id="@+id/copyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Copy device token" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Test local alarm" />

    </LinearLayout>
</ScrollView>
